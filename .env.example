# momentum-mcp environment variables
# Copy this file to .env and fill in your values. Never commit .env to git.

# ── Data Source Fallbacks ──────────────────────────────────────────────────────
# If yfinance fails, get_historical_data will try these in order.
# Leave empty to disable a fallback source.

# MetaTrader MCP server URL (SSE endpoint). Example: http://10.0.1.105:8080/sse
MT5_MCP_URL=

# TwelveData API key (https://twelvedata.com/) — used as a tertiary fallback
TWELVEDATA_API_KEY=

# ── Existing configuration ─────────────────────────────────────────────────────
# TraderDaddy Pro REST API
TRADERDADDY_API_URL=
TRADERDADDY_EMAIL=
TRADERDADDY_PASSWORD=

# AI board members (Constellation)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# MCP server transport
MCP_TRANSPORT=sse
MCP_HOST=127.0.0.1
MCP_PORT=8401
MCP_SSE_PATH=/mcp/sse